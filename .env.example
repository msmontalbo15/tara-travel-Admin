APP_NAME="Tara Travel Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────────────────
# DATABASE — points at the SAME Supabase Postgres instance the Flutter app
# and its Supabase migrations use. Nothing here creates new app tables;
# it only adds one Laravel-native table (admin_users) for dashboard staff
# logins, kept separate from Supabase Auth / public.users.
#
# Get these values from your Supabase project: Settings -> Database.
#
# Two connection styles Supabase offers — pick one:
#
#   1) Transaction pooler (recommended for a web app, port 6543)
#      Handles many short-lived connections well. Laravel 13 has native
#      support for this — DB_POOLED=true below tells Laravel to handle
#      emulated prepares/binding the pooler needs automatically.
#
#   2) Direct connection (port 5432)
#      Use this if you hit issues with prepared statements under the
#      pooler, or when running the one-off `admin_users` migration.
# ─────────────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-supabase-db-password
DB_SSLMODE=require
DB_POOLED=true
# Direct Supabase connection for Admin-schema migrations.
DB_DIRECT_HOST=your-project-ref.supabase.co
DB_DIRECT_PORT=5432

# File-based on purpose: keeps Laravel's own bookkeeping (sessions/cache/
# queue) out of the shared Supabase database, which only exists to serve
# the app's own tables (users, trips, expenses, ...).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
